<%- include('../partials/header') %>

<div class="max-w-xl mx-auto py-16 text-center">
  <div class="w-20 h-20 rounded-3xl bg-rose-100 text-rose-600 flex items-center justify-center text-3xl mx-auto mb-6 shadow-lg shadow-rose-500/20">
    <i class="fas fa-triangle-exclamation"></i>
  </div>

  <span class="inline-block px-3 py-1 rounded-full bg-rose-100 text-rose-800 font-bold text-xs uppercase tracking-wider mb-2">
    500 Internal Server Error
  </span>

  <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-3">
    Terjadi Kendala pada Sistem
  </h1>

  <p class="text-slate-600 text-sm mb-6 leading-relaxed">
    <%= typeof error !== 'undefined' ? error : 'Server mengalami kendala internal dalam memproses permintaan Anda.' %>
  </p>

  <a href="/dashboard" class="inline-flex items-center space-x-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-lg shadow-blue-600/30 transition">
    <i class="fas fa-arrow-left"></i>
    <span>Kembali ke Dashboard</span>
  </a>
</div>

<%- include('../partials/footer') %>
