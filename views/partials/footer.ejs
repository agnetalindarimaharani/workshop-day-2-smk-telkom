      <div class="flex flex-col sm:flex-row items-center justify-between max-w-7xl mx-auto gap-2">
        <p>&copy; 2026 <strong><%= schoolName %></strong> — Sistem Peminjaman Sarpras Lab RPL & Elektronika.</p>
        <p class="text-slate-400">Arsitektur MVC Express.js + SQLite Prisma ORM + RBAC 3-Level</p>
      </div>
    </footer>
  </div>
<% } %>

</body>
</html>
