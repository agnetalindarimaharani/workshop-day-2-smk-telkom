<%- include('../partials/header') %>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Sirkulasi & Peminjaman Sarpras Lab</h1>
    <p class="text-sm text-slate-500 mt-1">
      <%= user.role === 'PEMINJAM' ? 'Daftar riwayat dan status peminjaman alat praktikum Anda' : 'Monitoring lalu lintas peminjaman, approval laboran, dan pemeriksaan fisik alat' %>
    </p>
  </div>
  <% if (user.role === 'PEMINJAM' || user.role === 'ADMIN') { %>
    <a href="/borrowings/create" class="inline-flex items-center space-x-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-bold shadow-lg shadow-blue-600/30 transition">
      <i class="fas fa-plus-circle"></i>
      <span>Ajukan Peminjaman Alat</span>
    </a>
  <% } %>
</div>

<!-- Status Filter Pills & Search -->
<div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm mb-6 space-y-3">
  <!-- Status Tabs -->
  <div class="flex flex-wrap gap-2 pb-2 border-b border-slate-100 text-xs font-semibold">
    <a href="/borrowings?status=ALL&search=<%= search %>" class="px-3.5 py-1.5 rounded-lg transition <%= selectedStatus === 'ALL' ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
      Semua Status
    </a>
    <a href="/borrowings?status=PENDING&search=<%= search %>" class="px-3.5 py-1.5 rounded-lg transition <%= selectedStatus === 'PENDING' ? 'bg-amber-500 text-white shadow-sm' : 'bg-amber-50 text-amber-700 hover:bg-amber-100' %>">
      Menunggu Approval
    </a>
    <a href="/borrowings?status=APPROVED&search=<%= search %>" class="px-3.5 py-1.5 rounded-lg transition <%= selectedStatus === 'APPROVED' ? 'bg-blue-600 text-white shadow-sm' : 'bg-blue-50 text-blue-700 hover:bg-blue-100' %>">
      Sedang Dipinjam
    </a>
    <a href="/borrowings?status=RETURNED&search=<%= search %>" class="px-3.5 py-1.5 rounded-lg transition <%= selectedStatus === 'RETURNED' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100' %>">
      Sudah Kembali
    </a>
    <a href="/borrowings?status=REJECTED&search=<%= search %>" class="px-3.5 py-1.5 rounded-lg transition <%= selectedStatus === 'REJECTED' ? 'bg-rose-600 text-white shadow-sm' : 'bg-rose-50 text-rose-700 hover:bg-rose-100' %>">
      Ditolak
    </a>
  </div>

  <!-- Search Input Form -->
  <form action="/borrowings" method="GET" class="flex gap-2">
    <input type="hidden" name="status" value="<%= selectedStatus %>">
    <div class="relative flex-1">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <i class="fas fa-search"></i>
      </div>
      <input 
        type="text" 
        name="search" 
        value="<%= search %>" 
        placeholder="Cari berdasarkan nama siswa, alat, atau NISN..." 
        class="w-full pl-10 pr-4 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white text-slate-800"
      >
    </div>
    <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl transition">
      Cari
    </button>
    <% if (search) { %>
      <a href="/borrowings?status=<%= selectedStatus %>" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs font-semibold flex items-center">
        Reset
      </a>
    <% } %>
  </form>
</div>

<!-- Circulation Table Card -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
  <% if (borrowings.length === 0) { %>
    <div class="py-16 text-center text-slate-400">
      <i class="fas fa-inbox text-5xl mb-3 text-slate-300"></i>
      <h3 class="text-base font-bold text-slate-700">Tidak ada sirkulasi peminjaman</h3>
      <p class="text-xs text-slate-400 mt-1">Gunakan filter status lain atau buat permohonan baru.</p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-50">
            <th class="py-3.5 px-4">Peminjam</th>
            <th class="py-3.5 px-4">Alat Praktikum</th>
            <th class="py-3.5 px-3 text-center">Unit</th>
            <th class="py-3.5 px-4">Jadwal Pinjam</th>
            <th class="py-3.5 px-4 text-center">Status</th>
            <th class="py-3.5 px-4">Hasil Pengembalian</th>
            <th class="py-3.5 px-4 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% borrowings.forEach(b => { %>
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-4 px-4">
                <div class="font-bold text-slate-900"><%= b.user.nama %></div>
                <div class="text-[11px] text-slate-400 font-mono"><%= b.user.nisn || '@' + b.user.username %></div>
              </td>
              <td class="py-4 px-4">
                <div class="font-semibold text-slate-800"><%= b.tool.namaAlat %></div>
                <div class="text-[11px] text-slate-400"><%= b.tool.category ? b.tool.category.namaKategori : 'Lab' %></div>
              </td>
              <td class="py-4 px-3 text-center font-bold text-slate-700">
                <%= b.jumlah %>
              </td>
              <td class="py-4 px-4 text-xs whitespace-nowrap">
                <div class="text-slate-700 font-medium">Pinjam: <%= formatDate(b.tglPinjam) %></div>
                <div class="text-slate-400">Rencana: <%= formatDate(b.tglKembaliRencana) %></div>
              </td>
              <td class="py-4 px-4 text-center whitespace-nowrap">
                <% if (b.status === 'PENDING') { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300">
                    <i class="fas fa-hourglass-half mr-1 text-[10px]"></i> Menunggu
                  </span>
                <% } else if (b.status === 'APPROVED') { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-300">
                    <i class="fas fa-circle-check mr-1 text-[10px]"></i> Dipinjam
                  </span>
                <% } else if (b.status === 'RETURNED') { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                    <i class="fas fa-check-double mr-1 text-[10px]"></i> Kembali
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-300">
                    <i class="fas fa-times-circle mr-1 text-[10px]"></i> Ditolak
                  </span>
                <% } %>
              </td>
              <td class="py-4 px-4 text-xs">
                <% if (b.status === 'RETURNED') { %>
                  <div class="flex items-center space-x-1.5">
                    <span class="font-semibold text-slate-600">Kondisi:</span>
                    <% if (b.kondisiKembali === 'RUSAK') { %>
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-300">RUSAK</span>
                    <% } else { %>
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">BAIK</span>
                    <% } %>
                  </div>
                  <% if (b.denda > 0) { %>
                    <div class="text-rose-600 font-bold mt-0.5">Denda: <%= formatRupiah(b.denda) %></div>
                  <% } else { %>
                    <div class="text-slate-400 mt-0.5">Denda: Rp 0</div>
                  <% } %>
                  <div class="text-[10px] text-slate-400 mt-0.5">Inspeksi: <%= b.toolman ? b.toolman.nama : 'Toolman' %></div>
                <% } else if (b.status === 'APPROVED' && b.catatan && b.catatan.includes('meja Toolman')) { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-100 text-amber-800 border border-amber-300">
                    <i class="fas fa-bell mr-1"></i> Di Meja Toolman
                  </span>
                <% } else { %>
                  <span class="text-slate-400">-</span>
                <% } %>
              </td>
              <td class="py-4 px-4 text-right whitespace-nowrap">
                <div class="inline-flex items-center justify-end space-x-1.5">
                  <!-- TOOLMAN / ADMIN: APPROVAL / REJECT -->
                  <% if ((user.role === 'TOOLMAN' || user.role === 'ADMIN') && b.status === 'PENDING') { %>
                    <form action="/borrowings/<%= b.id %>/approve" method="POST" onsubmit="return confirm('Setujui peminjaman ini? Stok inventaris akan berkurang otomatis.')">
                      <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition flex items-center space-x-1 cursor-pointer">
                        <i class="fas fa-check"></i>
                        <span>Setujui</span>
                      </button>
                    </form>
                    <form action="/borrowings/<%= b.id %>/reject" method="POST" onsubmit="return confirm('Tolak permohonan pinjam alat ini?')">
                      <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-semibold transition cursor-pointer">
                        Tolak
                      </button>
                    </form>
                  <% } %>

                  <!-- TOOLMAN / ADMIN: INSPEKSI PENGEMBALIAN & DENDA -->
                  <% if ((user.role === 'TOOLMAN' || user.role === 'ADMIN') && b.status === 'APPROVED') { %>
                    <a href="/borrowings/<%= b.id %>/return" class="px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-sm transition flex items-center space-x-1">
                      <i class="fas fa-clipboard-check"></i>
                      <span>Inspeksi & Terima</span>
                    </a>
                  <% } %>

                  <!-- PEMINJAM: SERAHKAN ALAT KE MEJA TOOLMAN -->
                  <% if (user.role === 'PEMINJAM' && b.status === 'APPROVED') { %>
                    <form action="/borrowings/<%= b.id %>/return-request" method="POST" onsubmit="return confirm('Konfirmasi serahkan alat ke meja Toolman?')">
                      <button type="submit" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-sm transition flex items-center space-x-1 cursor-pointer">
                        <i class="fas fa-box-open"></i>
                        <span>Serahkan ke Meja Toolman</span>
                      </button>
                    </form>
                  <% } %>

                  <!-- ADMIN: DELETE RECORD -->
                  <% if (user.role === 'ADMIN') { %>
                    <form action="/borrowings/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Hapus data transaksi peminjaman ini?')">
                      <button type="submit" class="p-1.5 rounded-lg bg-slate-100 hover:bg-rose-50 text-slate-500 hover:text-rose-600 text-xs transition" title="Hapus Transaksi">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
