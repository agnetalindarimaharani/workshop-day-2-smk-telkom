<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <a href="/borrowings" class="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center mb-1">
        <i class="fas fa-arrow-left mr-1.5"></i> Kembali ke Sirkulasi
      </a>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Formulir Permohonan Pinjam Alat</h1>
      <p class="text-xs text-slate-500 mt-1">Ajukan peminjaman peralatan laboratorium untuk kegiatan praktikum</p>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
    
    <!-- Quick Fill Template for Scenario 3 -->
    <div class="mb-6 p-4 rounded-xl bg-emerald-50/80 border border-emerald-200">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-emerald-800 flex items-center">
          <i class="fas fa-bolt text-amber-500 mr-1.5"></i> Template Pengujian Cepat (Skenario 3 UKK)
        </span>
        <span class="text-[11px] text-emerald-700">Klik untuk auto-fill formulir</span>
      </div>
      <button type="button" onclick="fillScenario3()" class="px-3 py-1.5 rounded-lg bg-white hover:bg-emerald-100 text-emerald-800 border border-emerald-300 text-xs font-bold shadow-xs transition flex items-center space-x-1.5">
        <span>🌐 Siswa Pinjam 1 Unit Mikrotik untuk Praktikum Jaringan</span>
      </button>
    </div>

    <form action="/borrowings" method="POST" class="space-y-5">
      <!-- Jika Admin, bisa memilih siswa peminjam -->
      <% if (user.role === 'ADMIN' && typeof users !== 'undefined' && users.length > 0) { %>
        <div>
          <label for="targetUserId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Nama Siswa / Peminjam <span class="text-rose-500">*</span>
          </label>
          <select name="targetUserId" id="targetUserId" required class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 text-slate-800">
            <option value="">-- Pilih Siswa --</option>
            <% users.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.nama %> (NISN: <%= u.nisn || u.username %>)</option>
            <% }) %>
          </select>
        </div>
      <% } else { %>
        <!-- Siswa Peminjam Aktif Info -->
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between">
          <div>
            <span class="text-xs text-slate-400 font-semibold block">Nama Pemohon (Siswa):</span>
            <span class="text-sm font-bold text-slate-800"><%= user.nama %></span>
          </div>
          <span class="text-xs font-mono text-slate-500 bg-white px-2.5 py-1 rounded-lg border border-slate-200">
            NISN: <%= user.nisn || user.username %>
          </span>
        </div>
      <% } %>

      <div>
        <label for="toolId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Pilih Alat Praktikum <span class="text-rose-500">*</span>
        </label>
        <select name="toolId" id="toolId" required onchange="updateToolInfo()" class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 text-slate-800">
          <option value="">-- Pilih Peralatan Lab --</option>
          <% tools.forEach(t => { %>
            <option 
              value="<%= t.id %>" 
              data-stock="<%= t.stok %>" 
              data-spec="<%= t.spesifikasi || '' %>" 
              data-name="<%= t.namaAlat %>"
              <%= preselectedToolId === t.id ? 'selected' : '' %>
            >
              <%= t.namaAlat %> — [Tersedia: <%= t.stok %> Unit] (<%= t.category ? t.category.namaKategori : 'Lab' %>)
            </option>
          <% }) %>
        </select>
        <div id="toolInfoBox" class="mt-2 text-xs text-slate-500 hidden">
          <span class="font-semibold text-slate-700">Spesifikasi:</span> <span id="toolSpecText"></span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="jumlah" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Jumlah Unit yang Dipinjam <span class="text-rose-500">*</span>
          </label>
          <input 
            type="number" 
            name="jumlah" 
            id="jumlah" 
            min="1" 
            value="1" 
            required 
            class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 text-slate-800"
          >
        </div>

        <div>
          <label for="tglKembaliRencana" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Rencana Tanggal Pengembalian <span class="text-rose-500">*</span>
          </label>
          <% 
            const defaultReturn = new Date();
            defaultReturn.setDate(defaultReturn.getDate() + 2);
            const returnString = defaultReturn.toISOString().split('T')[0];
          %>
          <input 
            type="date" 
            name="tglKembaliRencana" 
            id="tglKembaliRencana" 
            required 
            value="<%= returnString %>"
            class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 text-slate-800"
          >
        </div>
      </div>

      <div>
        <label for="catatan" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Tujuan Praktikum / Keterangan Tambahan
        </label>
        <textarea 
          name="catatan" 
          id="catatan" 
          rows="3" 
          placeholder="Contoh: Praktikum konfigurasi MikroTik VLAN dan routing dinamis OSPF mata pelajaran Administrasi Infrastruktur Jaringan di Lab Komputer 1."
          class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 text-slate-800"
        ></textarea>
      </div>

      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-3">
        <a href="/borrowings" class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-50 font-semibold text-xs transition">
          Batal
        </a>
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-lg shadow-blue-600/30 transition flex items-center space-x-1.5 cursor-pointer">
          <i class="fas fa-paper-plane"></i>
          <span>Kirim Permohonan Peminjaman</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function updateToolInfo() {
    const select = document.getElementById('toolId');
    const selectedOption = select.options[select.selectedIndex];
    const infoBox = document.getElementById('toolInfoBox');
    const specText = document.getElementById('toolSpecText');
    
    if (selectedOption && selectedOption.dataset.spec) {
      specText.innerText = selectedOption.dataset.spec;
      infoBox.classList.remove('hidden');
    } else {
      infoBox.classList.add('hidden');
    }
  }

  function fillScenario3() {
    const select = document.getElementById('toolId');
    for (let opt of select.options) {
      if (opt.text.toLowerCase().includes('mikrotik')) {
        select.value = opt.value;
        break;
      }
    }
    updateToolInfo();
    document.getElementById('jumlah').value = '1';
    document.getElementById('catatan').value = 'Tugas Praktikum Jaringan Komputer: Konfigurasi Routing Statis & DHCP Server di Lab RPL.';
  }

  window.addEventListener('DOMContentLoaded', updateToolInfo);
</script>

<%- include('../partials/footer') %>
