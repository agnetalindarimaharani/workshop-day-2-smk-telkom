<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <a href="/tools" class="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center mb-1">
        <i class="fas fa-arrow-left mr-1.5"></i> Kembali ke Inventaris
      </a>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Tambah Alat Praktikum Baru</h1>
      <p class="text-xs text-slate-500 mt-1">Registrasi aset sarana alat baru ke database laboratorium</p>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
    
    <!-- Quick Fill Template Helper for Testing (Scenario 2) -->
    <div class="mb-6 p-4 rounded-xl bg-blue-50/70 border border-blue-200">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-blue-800 flex items-center">
          <i class="fas fa-lightbulb text-amber-500 mr-1.5"></i> Template Pengujian Cepat (Skenario 2 UKK)
        </span>
        <span class="text-[11px] text-blue-600">Klik untuk auto-fill formulir</span>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" onclick="fillMikrotik()" class="px-2.5 py-1.5 rounded-lg bg-white hover:bg-blue-100 text-blue-800 border border-blue-300 text-xs font-semibold shadow-xs transition">
          🚀 Mikrotik RouterBoard (Stok 5 Unit)
        </button>
        <button type="button" onclick="fillOsiloskop()" class="px-2.5 py-1.5 rounded-lg bg-white hover:bg-blue-100 text-blue-800 border border-blue-300 text-xs font-semibold shadow-xs transition">
          ⚡ Digital Oscilloscope 100MHz (Stok 2 Unit)
        </button>
      </div>
    </div>

    <form action="/tools" method="POST" class="space-y-5">
      <div>
        <label for="namaAlat" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Nama Alat Praktikum <span class="text-rose-500">*</span>
        </label>
        <input 
          type="text" 
          name="namaAlat" 
          id="namaAlat" 
          required 
          placeholder="Contoh: Router Mikrotik RB750Gr3 / Crimping Tool RJ45" 
          value="<%= typeof formData !== 'undefined' && formData.namaAlat ? formData.namaAlat : '' %>"
          class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-slate-800"
        >
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="categoryId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Kategori Alat <span class="text-rose-500">*</span>
          </label>
          <select name="categoryId" id="categoryId" required class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-slate-800">
            <option value="">-- Pilih Kategori --</option>
            <% categories.forEach(c => { %>
              <option value="<%= c.id %>" <%= typeof formData !== 'undefined' && formData.categoryId == c.id ? 'selected' : '' %>>
                <%= c.namaKategori %>
              </option>
            <% }) %>
          </select>
        </div>

        <div>
          <label for="stok" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Jumlah Stok Fisik <span class="text-rose-500">*</span>
          </label>
          <input 
            type="number" 
            name="stok" 
            id="stok" 
            min="0" 
            required 
            placeholder="Contoh: 5" 
            value="<%= typeof formData !== 'undefined' && formData.stok !== undefined ? formData.stok : '5' %>"
            class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-slate-800"
          >
        </div>
      </div>

      <div>
        <label for="kondisi" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Kondisi Fisik Alat <span class="text-rose-500">*</span>
        </label>
        <select name="kondisi" id="kondisi" required class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-slate-800">
          <option value="BAIK" selected>BAIK (Siap Pakai untuk Praktikum)</option>
          <option value="RUSAK">RUSAK (Perlu Perbaikan / Maintenance)</option>
        </select>
      </div>

      <div>
        <label for="spesifikasi" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Spesifikasi Teknis & Lokasi Rak Simpan
        </label>
        <textarea 
          name="spesifikasi" 
          id="spesifikasi" 
          rows="3" 
          placeholder="Contoh: 5x Gigabit Ethernet, Dual Core CPU 880MHz, Rak Jaringan Lab RPL B2"
          class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-slate-800"
        ><%= typeof formData !== 'undefined' && formData.spesifikasi ? formData.spesifikasi : '' %></textarea>
      </div>

      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-3">
        <a href="/tools" class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-50 font-semibold text-xs transition">
          Batal
        </a>
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-lg shadow-blue-600/30 transition flex items-center space-x-1.5 cursor-pointer">
          <i class="fas fa-save"></i>
          <span>Simpan Alat ke Inventaris</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function fillMikrotik() {
    document.getElementById('namaAlat').value = 'Mikrotik RouterBoard RB750Gr3';
    document.getElementById('stok').value = '5';
    document.getElementById('kondisi').value = 'BAIK';
    document.getElementById('spesifikasi').value = '5x Gigabit Ethernet, Dual Core CPU 880MHz, RouterOS v7 Level 4, Rak Lab Jaringan A3';
    const catSelect = document.getElementById('categoryId');
    for (let opt of catSelect.options) {
      if (opt.text.includes('Jaringan')) {
        catSelect.value = opt.value;
        break;
      }
    }
  }

  function fillOsiloskop() {
    document.getElementById('namaAlat').value = 'Digital Oscilloscope Rigol DS1054Z 100MHz';
    document.getElementById('stok').value = '2';
    document.getElementById('kondisi').value = 'BAIK';
    document.getElementById('spesifikasi').value = '4 Channels, 50MHz-100MHz, 1GSa/s Real-time sample rate, Meja Praktikum Elektronika Lab 2';
    const catSelect = document.getElementById('categoryId');
    for (let opt of catSelect.options) {
      if (opt.text.includes('Elektronika')) {
        catSelect.value = opt.value;
        break;
      }
    }
  }
</script>

<%- include('../partials/footer') %>
