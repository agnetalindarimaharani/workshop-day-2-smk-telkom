<%- include('../partials/header') %>

<!-- Top Toolman Banner -->
<div class="mb-8 bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 rounded-2xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
  <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-blue-500/20 text-blue-200 text-xs font-semibold backdrop-blur-sm mb-3 border border-blue-400/30">
        <i class="fas fa-tools text-blue-400"></i>
        <span>Posisi: Toolman / Laboran Bengkel & Lab Komputer</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Meja Kerja Toolman: <%= user.nama %></h1>
      <p class="text-slate-300 text-sm mt-1 max-w-xl">
        Kelola permohonan peminjaman praktikum, inspeksi fisik alat saat kembali, penagihan denda kerusakan, dan cetak laporan sirkulasi resmi.
      </p>
    </div>
    <div class="flex flex-wrap gap-2.5 shrink-0">
      <a href="/reports" class="inline-flex items-center space-x-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs sm:text-sm font-bold shadow-lg shadow-blue-600/30 transition">
        <i class="fas fa-print"></i>
        <span>Cetak Laporan Sirkulasi</span>
      </a>
      <a href="/tools" class="inline-flex items-center space-x-2 px-4 py-2.5 bg-white/10 hover:bg-white/20 text-white rounded-xl text-xs sm:text-sm font-semibold backdrop-blur-sm transition border border-white/20">
        <i class="fas fa-boxes-stacked"></i>
        <span>Cek Ketersediaan Alat</span>
      </a>
    </div>
  </div>
</div>

<!-- 4 Toolman Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
  <!-- Card 1: Menunggu Persetujuan (PENTING) -->
  <div class="bg-white p-5 rounded-2xl border-2 <%= stats.pendingCount > 0 ? 'border-amber-400 bg-amber-50/20' : 'border-slate-200' %> shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-amber-600">Perlu Persetujuan</p>
        <h3 class="text-3xl font-black text-amber-700 mt-1"><%= stats.pendingCount %></h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl">
        <i class="fas fa-hand-holding-hand"></i>
      </div>
    </div>
    <p class="text-xs text-slate-500 mt-3">
      Permohonan siswa yang belum di-approve
    </p>
  </div>

  <!-- Card 2: Sedang Dipinjam -->
  <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-blue-600">Sedang Dipinjam</p>
        <h3 class="text-3xl font-black text-blue-700 mt-1"><%= stats.activeCount %></h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
        <i class="fas fa-clock"></i>
      </div>
    </div>
    <p class="text-xs text-slate-500 mt-3">
      Alat masih berada di tangan siswa/guru
    </p>
  </div>

  <!-- Card 3: Pengembalian Selesai -->
  <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">Selesai Dikembalikan</p>
        <h3 class="text-3xl font-black text-emerald-700 mt-1"><%= stats.returnedCount %></h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
        <i class="fas fa-circle-check"></i>
      </div>
    </div>
    <p class="text-xs text-slate-500 mt-3">
      Telah diinspeksi oleh Toolman
    </p>
  </div>

  <!-- Card 4: Total Denda -->
  <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-rose-600">Total Denda Kerusakan</p>
        <h3 class="text-xl font-black text-rose-700 mt-1"><%= formatRupiah(stats.totalDenda) %></h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl">
        <i class="fas fa-money-bill-wave"></i>
      </div>
    </div>
    <p class="text-xs text-slate-500 mt-3">
      Biaya ganti rugi fisik alat rusak/hilang
    </p>
  </div>
</div>

<!-- SECTION 1: PERMOHONAN PINJAM MASUK (PENDING APPROVAL) -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-8">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h3 class="text-lg font-bold text-slate-900 flex items-center space-x-2">
        <span>Permohonan Peminjaman Menunggu Persetujuan</span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300">
          <%= pendingBorrowings.length %> Menunggu
        </span>
      </h3>
      <p class="text-xs text-slate-500 mt-0.5">Setujui permohonan untuk mengurangi stok alat di lab secara otomatis</p>
    </div>
  </div>

  <% if (pendingBorrowings.length === 0) { %>
    <div class="py-10 text-center rounded-xl bg-slate-50 border border-dashed border-slate-200 text-slate-400">
      <i class="fas fa-check-circle text-4xl text-emerald-500 mb-2"></i>
      <p class="text-sm font-medium text-slate-600">Semua permohonan peminjaman telah diproses!</p>
      <p class="text-xs text-slate-400">Tidak ada pengajuan alat baru yang menunggu tindakan saat ini.</p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-50">
            <th class="py-3 px-4 rounded-l-lg">Siswa / Peminjam</th>
            <th class="py-3 px-4">Alat Praktikum</th>
            <th class="py-3 px-4 text-center">Unit</th>
            <th class="py-3 px-4">Rencana Kembali</th>
            <th class="py-3 px-4">Catatan Praktikum</th>
            <th class="py-3 px-4 text-right rounded-r-lg">Aksi Toolman</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% pendingBorrowings.forEach(item => { %>
            <tr class="hover:bg-slate-50 transition">
              <td class="py-4 px-4">
                <div class="font-bold text-slate-900"><%= item.user.nama %></div>
                <div class="text-xs text-slate-500 font-mono">NISN: <%= item.user.nisn || '-' %> • Telp: <%= item.user.telepon || '-' %></div>
              </td>
              <td class="py-4 px-4">
                <div class="font-semibold text-slate-800"><%= item.tool.namaAlat %></div>
                <div class="text-xs text-slate-500">Stok Lab Saat Ini: <span class="font-bold <%= item.tool.stok >= item.jumlah ? 'text-emerald-600' : 'text-rose-600' %>"><%= item.tool.stok %> unit</span></div>
              </td>
              <td class="py-4 px-4 text-center">
                <span class="inline-block px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 font-bold text-xs border border-blue-200">
                  <%= item.jumlah %> Unit
                </span>
              </td>
              <td class="py-4 px-4 text-xs text-slate-600 whitespace-nowrap">
                <%= formatDate(item.tglKembaliRencana) %>
              </td>
              <td class="py-4 px-4 text-xs text-slate-500 max-w-xs">
                <%= item.catatan || 'Praktikum Reguler' %>
              </td>
              <td class="py-4 px-4 text-right whitespace-nowrap">
                <div class="inline-flex items-center space-x-2">
                  <!-- Tombol Setujui -->
                  <form action="/borrowings/<%= item.id %>/approve" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menyetujui peminjaman <%= item.jumlah %> unit <%= item.tool.namaAlat %> untuk <%= item.user.nama %>? Stok akan berkurang otomatis.')">
                    <button type="submit" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-sm transition flex items-center space-x-1 cursor-pointer">
                      <i class="fas fa-check"></i>
                      <span>Setujui</span>
                    </button>
                  </form>

                  <!-- Tombol Tolak -->
                  <form action="/borrowings/<%= item.id %>/reject" method="POST" onsubmit="return confirm('Tolak permohonan pinjam alat ini?')">
                    <button type="submit" class="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-semibold text-xs transition flex items-center space-x-1 cursor-pointer">
                      <i class="fas fa-times"></i>
                      <span>Tolak</span>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- SECTION 2: ALAT SEDANG DIPINJAM (MENUNGGU INSPEKSI PENGEMBALIAN) -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h3 class="text-lg font-bold text-slate-900 flex items-center space-x-2">
        <span>Alat Sedang Dipinjam (Dalam Sirkulasi Praktikum)</span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-300">
          <%= activeBorrowings.length %> Aktif
        </span>
      </h3>
      <p class="text-xs text-slate-500 mt-0.5">Klik tombol "Proses Pengembalian" saat siswa mengembalikan alat untuk cek kondisi fisik & denda</p>
    </div>
  </div>

  <% if (activeBorrowings.length === 0) { %>
    <div class="py-10 text-center rounded-xl bg-slate-50 border border-dashed border-slate-200 text-slate-400">
      <i class="fas fa-boxes-packing text-4xl text-slate-300 mb-2"></i>
      <p class="text-sm font-medium text-slate-600">Tidak ada alat yang sedang dipinjam saat ini.</p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-50">
            <th class="py-3 px-4 rounded-l-lg">Peminjam</th>
            <th class="py-3 px-4">Alat Praktikum</th>
            <th class="py-3 px-4 text-center">Unit</th>
            <th class="py-3 px-4">Batas Waktu Kembali</th>
            <th class="py-3 px-4">Status & Catatan</th>
            <th class="py-3 px-4 text-right rounded-r-lg">Aksi Inspeksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% activeBorrowings.forEach(item => { %>
            <tr class="hover:bg-slate-50 transition">
              <td class="py-4 px-4">
                <div class="font-bold text-slate-900"><%= item.user.nama %></div>
                <div class="text-xs text-slate-500 font-mono"><%= item.user.nisn || item.user.telepon %></div>
              </td>
              <td class="py-4 px-4">
                <div class="font-semibold text-slate-800"><%= item.tool.namaAlat %></div>
                <div class="text-xs text-slate-500">Dipinjam: <%= formatDate(item.tglPinjam) %></div>
              </td>
              <td class="py-4 px-4 text-center">
                <span class="inline-block px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 font-bold text-xs border border-blue-200">
                  <%= item.jumlah %> Unit
                </span>
              </td>
              <td class="py-4 px-4 text-xs font-semibold whitespace-nowrap <%= new Date(item.tglKembaliRencana) < new Date() ? 'text-rose-600' : 'text-slate-600' %>">
                <%= formatDate(item.tglKembaliRencana) %>
                <% if (new Date(item.tglKembaliRencana) < new Date()) { %>
                  <span class="block text-[10px] text-rose-500 font-bold">Terlambat!</span>
                <% } %>
              </td>
              <td class="py-4 px-4 text-xs text-slate-600 max-w-xs">
                <% if (item.catatan && item.catatan.includes('meja Toolman')) { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-100 text-amber-800 border border-amber-300 mb-1">
                    <i class="fas fa-bell mr-1"></i> Siswa serahkan ke meja
                  </span>
                <% } %>
                <p class="truncate"><%= item.catatan || '-' %></p>
              </td>
              <td class="py-4 px-4 text-right whitespace-nowrap">
                <a href="/borrowings/<%= item.id %>/return" class="inline-flex items-center space-x-1.5 px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-sm transition">
                  <i class="fas fa-clipboard-check"></i>
                  <span>Inspeksi & Terima Pengembalian</span>
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
