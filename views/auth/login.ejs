<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="h-full flex items-center justify-center p-4 sm:p-6 bg-gradient-to-br from-slate-100 via-blue-50 to-indigo-100">

  <div class="w-full max-w-md">
    <!-- Header Logo & Branding -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white shadow-xl shadow-blue-500/25 mb-4 transform hover:scale-105 transition-transform">
        <i class="fas fa-microchip text-2xl"></i>
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">SARPRAS LAB TELKOM</h1>
      <p class="text-sm font-medium text-slate-600 mt-1">Sistem Peminjaman Alat Praktikum Lab RPL & Elektronika</p>
      <div class="inline-flex items-center space-x-1.5 px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-semibold mt-2.5">
        <i class="fas fa-certificate text-[11px]"></i>
        <span>Standar UKK / Industri — 3 Level RBAC</span>
      </div>
    </div>

    <!-- Main Card -->
    <div class="bg-white rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-200/80 p-6 sm:p-8">
      
      <!-- Notifications -->
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="mb-5 p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center space-x-2.5">
          <i class="fas fa-check-circle text-emerald-600"></i>
          <span><%= success %></span>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center space-x-2.5">
          <i class="fas fa-exclamation-circle text-rose-600"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- Quick Switch Demo Account Bar -->
      <div class="mb-6 p-4 rounded-xl bg-slate-50 border border-slate-200">
        <div class="flex items-center justify-between mb-2.5">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500">
            <i class="fas fa-bolt text-amber-500 mr-1"></i> Quick Switch Demo Akun
          </span>
          <span class="text-[11px] text-slate-400">Klik untuk isi otomatis</span>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <!-- Button Demo Admin -->
          <button type="button" onclick="setDemo('admin', 'password123')" class="px-2.5 py-2 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200 text-xs font-bold transition flex flex-col items-center">
            <i class="fas fa-shield-alt mb-1 text-sm text-purple-600"></i>
            <span>Admin Lab</span>
          </button>
          
          <!-- Button Demo Toolman -->
          <button type="button" onclick="setDemo('toolman', 'password123')" class="px-2.5 py-2 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 text-xs font-bold transition flex flex-col items-center">
            <i class="fas fa-tools mb-1 text-sm text-blue-600"></i>
            <span>Toolman</span>
          </button>

          <!-- Button Demo Peminjam -->
          <button type="button" onclick="setDemo('peminjam', 'password123')" class="px-2.5 py-2 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 text-xs font-bold transition flex flex-col items-center">
            <i class="fas fa-user-graduate mb-1 text-sm text-emerald-600"></i>
            <span>Siswa</span>
          </button>
        </div>
      </div>

      <!-- Login Form -->
      <form action="/login" method="POST" class="space-y-4">
        <div>
          <label for="username" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Username Pengguna
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <i class="fas fa-user"></i>
            </div>
            <input 
              type="text" 
              name="username" 
              id="username" 
              required 
              placeholder="Contoh: admin / toolman / peminjam"
              value="<%= typeof username !== 'undefined' ? username : '' %>"
              class="w-full pl-10 pr-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition shadow-sm text-slate-800"
            >
          </div>
        </div>

        <div>
          <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Kata Sandi
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <i class="fas fa-lock"></i>
            </div>
            <input 
              type="password" 
              name="password" 
              id="password" 
              required 
              placeholder="••••••••"
              class="w-full pl-10 pr-10 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition shadow-sm text-slate-800"
            >
            <button type="button" onclick="togglePassword()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600">
              <i id="toggleIcon" class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full mt-2 py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-lg shadow-blue-600/30 hover:shadow-blue-600/50 transition-all flex items-center justify-center space-x-2 cursor-pointer"
        >
          <span>Masuk ke Sistem</span>
          <i class="fas fa-arrow-right text-xs"></i>
        </button>
      </form>

      <!-- Footer Info -->
      <div class="mt-6 pt-5 border-t border-slate-100 text-center">
        <p class="text-xs text-slate-500">
          Laboratorium Rekayasa Perangkat Lunak & Elektronika Industri
        </p>
      </div>

    </div>
  </div>

  <script>
    function setDemo(username, password) {
      document.getElementById('username').value = username;
      document.getElementById('password').value = password;
    }

    function togglePassword() {
      const input = document.getElementById('password');
      const icon = document.getElementById('toggleIcon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }
  </script>
</body>
</html>
