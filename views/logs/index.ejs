<%- include('../partials/header') %>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Audit Log Aktifitas Sistem Lab</h1>
    <p class="text-sm text-slate-500 mt-1">Rekam jejak digital seluruh operasi sirkulasi sarpras, login, dan modifikasi data lab</p>
  </div>
</div>

<!-- Filter Bar -->
<div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm mb-6">
  <form action="/logs" method="GET" class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
    <div class="sm:col-span-8 relative">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <i class="fas fa-search"></i>
      </div>
      <input 
        type="text" 
        name="search" 
        value="<%= search %>" 
        placeholder="Cari dalam keterangan / nama pengguna..." 
        class="w-full pl-10 pr-4 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white text-slate-800"
      >
    </div>

    <div class="sm:col-span-3">
      <select name="aksi" onchange="this.form.submit()" class="w-full py-2 px-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-700">
        <option value="ALL">Semua Jenis Aksi</option>
        <% actionTypes.forEach(type => { %>
          <option value="<%= type %>" <%= selectedAksi === type ? 'selected' : '' %>>
            <%= type %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="sm:col-span-1 flex space-x-1">
      <button type="submit" class="w-full py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition flex items-center justify-center">
        <i class="fas fa-filter"></i>
      </button>
      <% if (search || selectedAksi !== 'ALL') { %>
        <a href="/logs" class="py-2 px-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs font-semibold flex items-center justify-center">
          <i class="fas fa-times"></i>
        </a>
      <% } %>
    </div>
  </form>
</div>

<!-- Logs Table Card -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
  <% if (logs.length === 0) { %>
    <div class="py-16 text-center text-slate-400">
      <i class="fas fa-history text-5xl mb-3 text-slate-300"></i>
      <h3 class="text-base font-bold text-slate-700">Belum ada log aktivitas yang cocok</h3>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-50">
            <th class="py-3.5 px-4 w-44">Waktu Kejadian</th>
            <th class="py-3.5 px-4">Pengguna</th>
            <th class="py-3.5 px-4">Jenis Aksi</th>
            <th class="py-3.5 px-5">Rincian Keterangan Aktivitas</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% logs.forEach(log => { %>
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-3.5 px-4 whitespace-nowrap text-xs text-slate-500 font-mono">
                <%= formatDateTime(log.createdAt) %>
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap">
                <% if (log.user) { %>
                  <div class="font-bold text-slate-800 text-xs"><%= log.user.nama %></div>
                  <div class="text-[10px] text-slate-400">@<%= log.user.username %> (<%= log.user.role %>)</div>
                <% } else { %>
                  <span class="text-xs text-slate-400 italic">Sistem Otomatis</span>
                <% } %>
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap">
                <% if (log.aksi.includes('SETUJUI') || log.aksi.includes('PENGEMBALIAN')) { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                    <i class="fas fa-check mr-1 text-[10px]"></i> <%= log.aksi %>
                  </span>
                <% } else if (log.aksi.includes('AJUKAN')) { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300">
                    <i class="fas fa-paper-plane mr-1 text-[10px]"></i> <%= log.aksi %>
                  </span>
                <% } else if (log.aksi.includes('TAMBAH') || log.aksi.includes('UPDATE')) { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-300">
                    <i class="fas fa-edit mr-1 text-[10px]"></i> <%= log.aksi %>
                  </span>
                <% } else if (log.aksi.includes('HAPUS') || log.aksi.includes('TOLAK')) { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-300">
                    <i class="fas fa-trash-alt mr-1 text-[10px]"></i> <%= log.aksi %>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-800 border border-slate-300">
                    <i class="fas fa-info-circle mr-1 text-[10px]"></i> <%= log.aksi %>
                  </span>
                <% } %>
              </td>
              <td class="py-3.5 px-5 text-xs text-slate-700 leading-relaxed">
                <%= log.keterangan %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
